#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config FEATURE_OLED
	tristate "os feature of oled example"
	default m
	---help---
		Enable the oled example

if FEATURE_OLED

config FEATURE_OLED_PROGNAME
	string "Program name"
	default "oled"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config FEATURE_OLED_PRIORITY
	int "panel panel task priority"
	default 100

config FEATURE_OLED_STACKSIZE
	int "pthread stack size"
	default DEFAULT_TASK_STACKSIZE

endif
