#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config FEATURE_PLAYER
	tristate "os feature of player example"
	default m
	---help---
		Enable the player example

if FEATURE_PLAYER

config FEATURE_PLAYER_PROGNAME
	string "Program name"
	default "player"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config FEATURE_PLAYER_PRIORITY
	int "player task priority"
	default 100

config FEATURE_PLAYER_STACKSIZE
	int "player stack size"
	default DEFAULT_TASK_STACKSIZE

endif
