#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config FEATURE_TOUCH_PANEL
	tristate "os feature of touch panel example"
	default m
	---help---
		Enable the touch panel example

if FEATURE_TOUCH_PANEL

config FEATURE_TOUCH_PANEL_PROGNAME
	string "Program name"
	default "touchpanel"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config FEATURE_TOUCH_PANEL_PRIORITY
	int "panel panel task priority"
	default 100

config FEATURE_TOUCH_PANEL_STACKSIZE
	int "pthread stack size"
	default DEFAULT_TASK_STACKSIZE

endif
