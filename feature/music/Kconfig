#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config FEATURE_MUSIC
	tristate "os feature of music example"
	default m
	---help---
		Enable the music example

if FEATURE_MUSIC

config FEATURE_MUSIC_PROGNAME
	string "Program name"
	default "music"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config FEATURE_MUSIC_PRIORITY
	int "music task priority"
	default 100

config FEATURE_MUSIC_STACKSIZE
	int "music stack size"
	default DEFAULT_TASK_STACKSIZE

endif
